#!/usr/bin/env bash
# pre-retranslate.sample — BEFORE the retranslate task: the SAME container as
# the TRANSLATE_* role (retranslate re-uses the translate prompt + decoding).
# Copy to hooks/pre-retranslate.sh, chmod +x.
set -euo pipefail
exec "$(dirname "$0")/model-switch.sh" /path/to/your/Containers/index-translate
