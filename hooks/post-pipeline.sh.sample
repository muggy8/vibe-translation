#!/usr/bin/sh
# Sample: AFTER hook for the WHOLE default run (fires once, after all ten
# steps). $AI_CLIENT_TASK_SUCCEEDED is "0" if any step failed.
#
# Enable: cp hooks/post-pipeline.sh.sample hooks/post-pipeline.sh && chmod +x hooks/post-pipeline.sh
set -eu
cd "$AI_CLIENT_SERIES_DIR"

if [ "$AI_CLIENT_TASK_SUCCEEDED" = "1" ]; then
  git add .
  git commit -m "pipeline complete ($AI_CLIENT_SERIES_NAME)" || true
  git checkout main
  git merge pipeline
  git push
else
  echo "pipeline FAILED on $(hostname); branch left in place for inspection." >&2
fi
