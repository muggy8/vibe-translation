#!/usr/bin/sh
# Sample: AFTER hook for the style-guide step (git-style, per-step model).
# Runs even when the task failed ($AI_CLIENT_TASK_SUCCEEDED is "0" then).
#
# Enable: cp hooks/post-style-guide.sh.sample hooks/post-style-guide.sh && chmod +x hooks/post-style-guide.sh
set -eu
cd "$AI_CLIENT_SERIES_DIR"

if [ "$AI_CLIENT_TASK_SUCCEEDED" = "1" ]; then
  git add .
  git commit -m "completed style-guide ($AI_CLIENT_SERIES_NAME)" || true
  git checkout main
  git merge style-guide
  git push
else
  echo "style-guide FAILED on $(hostname); branch left in place for inspection." >&2
fi
