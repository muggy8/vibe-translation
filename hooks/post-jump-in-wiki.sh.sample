#!/usr/bin/sh
# Sample: AFTER hook for the jump-in-wiki step (git-style, per-step model).
# Runs even when the task failed ($AI_CLIENT_TASK_SUCCEEDED is "0" then).
#
# Enable: cp hooks/post-jump-in-wiki.sh.sample hooks/post-jump-in-wiki.sh && chmod +x hooks/post-jump-in-wiki.sh
set -eu
cd "$AI_CLIENT_SERIES_DIR"

if [ "$AI_CLIENT_TASK_SUCCEEDED" = "1" ]; then
  git add .
  git commit -m "completed jump-in-wiki ($AI_CLIENT_SERIES_NAME)" || true
  git checkout main
  git merge jump-in-wiki
  git push
else
  echo "jump-in-wiki FAILED on $(hostname); branch left in place for inspection." >&2
fi

# Optional: notify a person the step is done (uses only what's on this machine;
# no npm deps). Machine-local config (keys/recipients) — NOT committed.
# [ -f "$HOME/.ai-client/hooks.env" ] && . "$HOME/.ai-client/hooks.env"
# curl -sSf "$NOTIFY_API_URL" -H "Authorization: Bearer $NOTIFY_API_KEY" \
#   -H "Content-Type: application/json" \
#   -d "{\"subject\":\"[$AI_CLIENT_TASK] $AI_CLIENT_TASK_SUCCEEDED\",\"to\":\"$NOTIFY_EMAIL\"}"
