#!/usr/bin/sh
# Sample: AFTER hook for the character-voice step (git-style, per-step model).
# Runs even when the task failed ($AI_CLIENT_TASK_SUCCEEDED is "0" then).
#
# Enable: cp hooks/post-character-voice.sh.sample hooks/post-character-voice.sh && chmod +x hooks/post-character-voice.sh
set -eu
cd "$AI_CLIENT_SERIES_DIR"

if [ "$AI_CLIENT_TASK_SUCCEEDED" = "1" ]; then
  git add .
  git commit -m "completed character-voice ($AI_CLIENT_SERIES_NAME)" || true
  git checkout main
  git merge character-voice
  git push
else
  echo "character-voice FAILED on $(hostname); branch left in place for inspection." >&2
fi
