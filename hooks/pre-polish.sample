#!/usr/bin/env bash
# pre-polish.sample — BEFORE the polish task: this machine's container for the
# EDIT_* role (it may well be the same container as the VERIFY_* role). Copy to
# hooks/pre-polish.sh, chmod +x.
set -euo pipefail
exec "$(dirname "$0")/model-switch.sh" /path/to/your/Containers/<your-edit-model>