# Dependencies
node_modules/

# Environment files (may contain secrets)
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build / Output
dist/
build/

# Translation-target manifest (generated by get-translation-target.js)
translation-target.json

# Logs
.logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scratch series used for single-volume live tests
.scratch-series/
.scratch-classic/

# Scratch / diagnostic text files left by monitoring runs
.*.txt

# Dry-run prompt dumps
.dry-run/

# Pipeline hooks — per-machine executable scripts (git-style). The samples
# and README stay tracked; the real hooks are local-only (gitignored).
/hooks/*
!/hooks/README.md
!/hooks/*.sample

# Test fixture series: ignore EVERYTHING under test-series/ except the two
# source story files the tasks read. Every generated output (per-volume
# artifacts, state, sidecars, epub bundles, series-root copies) is ignored —
# the sources are the only inputs that matter for a fresh run. The re-include
# dance is required because git cannot re-include a file whose parent
# directory is excluded.
test-series/*
!test-series/test_story(1)/
!test-series/test_story(2)/
test-series/test_story(1)/*
test-series/test_story(2)/*
!test-series/test_story(1)/test_story(1).md
!test-series/test_story(2)/test_story(2).md

# Provenance sidecars (written next to each series-root artifact copy:
# glossary / character-voice / style-guide / shared-wiki / consistency-report)
*.provenance.json

# Rolling-window acceptance state (persisted by QA loop, read by skip-check)
*-rolling-state.json

# Epub bundle outputs (generated by utils/source.js: the whole/chapter/
# interlude Markdown files, extracted images, and the extraction cache)
*-bundle.meta.json
*-whole.md
*-ch[0-9]*.md
*-ch[0-9]*.[0-9]*.md

# Epub source files (kept out of git; the bundle cache in the volume folder
# is what the tasks read)
*.epub

# Testing coverage
coverage/
.nyc_output/

# Cache
.eslintcache
.stylelintcache
