# Dependencies
node_modules/

# Environment files (may contain secrets)
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build / Output
dist/
build/

# Translation-target manifest (generated by get-translation-target.js)
translation-target.json

# Logs
.logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scratch series used for single-volume live tests
.scratch-series/
.scratch-classic/

# Scratch / diagnostic text files left by monitoring runs
.*.txt

# Dry-run prompt dumps
.dry-run/

# Pipeline hooks — per-machine executable scripts (git-style). The samples
# and README stay tracked; the real hooks are local-only (gitignored).
/hooks/*
!/hooks/README.md
!/hooks/*.sample

# Test fixture series: the generated outputs (the story sources stay tracked)
test-series/**/wiki.md
test-series/**/shared-wiki.md
test-series/**/glossary.md
test-series/**/glossary-research.md
test-series/**/glossary-validation.md
test-series/**/jump-in-wiki-validation-*.md
test-series/**/character-voice.md
test-series/**/pov-map.md
test-series/**/character-voice-validation.md
test-series/**/style-guide.md
test-series/**/style-guide-validation.md
test-series/**/glossary-coverage.md
test-series/**/glossary-coverage.json
test-series/**/glossary-new-terms.json
test-series/**/character-voice-new.json
test-series/**/style-guide-new.json
test-series/**/chapters.json
test-series/**/translation-brief.md
test-series/glossary.md
test-series/character-voice.md
test-series/style-guide.md
test-series/shared-wiki.md
test-series/consistency-report.md

# Rolling-window acceptance state (persisted by QA loop, read by skip-check)
*-rolling-state.json

# Epub bundle outputs (generated by utils/source.js: the whole/chapter/
# interlude Markdown files, extracted images, and the extraction cache)
*-bundle.meta.json
*-whole.md
*-ch[0-9]*.md
*-ch[0-9]*.[0-9]*.md
test-series/**/images/

# Epub source files (kept out of git; the bundle cache in the volume folder
# is what the tasks read)
*.epub

# Testing coverage
coverage/
.nyc_output/

# Cache
.eslintcache
.stylelintcache
