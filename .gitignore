# Dependencies
node_modules/

# Environment files (may contain secrets)
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build / Output
dist/
build/

# Translation-target manifest + human-readable plan (generated by the discover step)
translation-target.json
translation-plan.md

# ── The run's own folders ─────────────────────────────────────────────────────
# A run keeps its records next to the series it worked on:
#   <SERIES_LOCATION>/.run/postmortem/   reports, ledger, tickets, patches, plan, lock
#   <SERIES_LOCATION>/.run/logs/         the transcript of every model call
#   <SERIES_LOCATION>/.run/dry-run/      the prompts --dry-run would have sent
# (configs/run-state.js). That folder writes its OWN ignore rule when it is created, so the
# split between "commit this so another machine can continue the run" and "this is one
# machine's transcripts" travels with it into whichever repository the series lives in.
#
# What is listed here is the fallback home — the repo's own folder, used only when no series
# was chosen — plus the names from before the move, so a leftover never looks like source.
/.run/
/.logs/
/.dry-run/
/.postmortem/
.logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scratch series used for single-volume live tests
.scratch-series/
.scratch-classic/

# Scratch / diagnostic text files left by monitoring runs
.*.txt

# Token calibration cache. This one deliberately did NOT move with the rest of the run's
# records: it measures the tokenizer of the model server THIS machine is pointed at
# (AI_BASE_URL), and a machine that has never met that endpoint must not inherit a
# measurement taken against someone else's. Machine state, like hooks/.model-switch-state.
.token-calibration.json
# Grader calibration: the fixture (test/calibration/cases/) is tracked; the
# reports it writes are per-machine history for the drift comparison.
test/calibration/calibration-report.md
test/calibration/calibration-report.json


# Pipeline hooks — per-machine executable scripts (git-style). The samples
# and README stay tracked; the real hooks are local-only (gitignored).
/hooks/*
!/hooks/README.md
!/hooks/*.sample

# Test fixture series: ignore EVERYTHING under test-series/ except the two
# source story files the tasks read. Every generated output (per-volume
# artifacts, state, sidecars, epub bundles, series-root copies) is ignored —
# the sources are the only inputs that matter for a fresh run. The re-include
# dance is required because git cannot re-include a file whose parent
# directory is excluded.
test-series/*
!test-series/test_story(1)/
!test-series/test_story(2)/
test-series/test_story(1)/*
test-series/test_story(2)/*
!test-series/test_story(1)/test_story(1).md
!test-series/test_story(2)/test_story(2).md

# Provenance sidecars, rolling-window acceptance state, and the translation stage's resume
# state (translation-state.json) are NO LONGER ignored. They are the pipeline's memory of what
# it already accepted and where a stage stopped, and they sit in the series folder — which is
# the folder you pull onto another machine to continue a run there instead of re-deriving it.
# (In this repo they only become visible when SERIES_LOCATION points at a tracked folder; the
# default epub_source/ stays ignored as a whole.)

# Epub bundle outputs (generated by utils/source.js: the whole/chapter/
# interlude Markdown files, extracted images, and the extraction cache)
*-bundle.meta.json
*-whole.md
*-ch[0-9]*.md
*-ch[0-9]*.[0-9]*.md

# Epub source files (kept out of git; the bundle cache in the volume folder
# is what the tasks read)
*.epub

# Default source folder (SERIES_LOCATION when unset — configs/env-defaults.js):
# the books you drop in, and everything the pipeline builds next to them, are
# yours and never committed. Only the README is tracked — EXCEPT the run's own
# records folder, which is re-included so a series kept in this repo still has
# its tickets, its ledger and its patch records in git (the folder's own
# .gitignore, written by the run, keeps the transcripts and the lock out).
epub_source/*
!epub_source/README.md
!epub_source/.run/

# ── Generated translation artifacts ─────────────────────────────────────────
# When SERIES_LOCATION points at a folder INSIDE this repo, the pipeline writes
# these into the series dir and its volume folders. They are ignored by name so
# they are never accidentally committed (a generated artifact is not source).
# The prompt templates that share some of these names (glossary.md,
# character-voice.md, style-guide.md) live in system-prompts/ and user-prompts/
# and are re-included below — git can re-include them because those parent
# directories are not themselves excluded.
glossary.md
glossary-research.md
glossary-new-terms.json
glossary-validation.md
glossary-coverage.md
glossary-coverage.json
character-voice.md
character-voice-new.json
character-voice-validation.md
pov-map.md
style-guide.md
style-guide-new.json
style-guide-validation.md
wiki.md
shared-wiki.md
jump-in-wiki-validation-*.md
wiki-*.md
chapters.json
translation-brief.md
translation.md
translation-qa.md
translation-verification.md
translation-verification.json
translation-whole.md
translation-ch[0-9]*.md
translation-part-[0-9]*.md
polished-*.md
polish-qa.md
polish-verification.json
consistency-report.md
volume-consistency.md
volume-consistency.json
translation-report.md
translation-report.json
glossary-disputes.md
glossary-disputes.json
translation-target.draft.json
translation-target.json.writing
*-parts.meta.json
.harness-smoke/
# Re-include the prompt templates (same names as some generated artifacts).
!system-prompts/**/*.md
!user-prompts/**/*.md

# Testing coverage
coverage/
.nyc_output/
