# OpenAI-compatible AI client — environment configuration
# Copy this file to .env and fill in your values.

# ── AI provider (OpenAI-compatible endpoint) ────────────────────────────────

# The base URL of your OpenAI-compatible endpoint
# Examples:
#   OpenAI:         https://api.openai.com/v1
#   Ollama (local): http://localhost:11434/v1
#   Azure:          https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
AI_BASE_URL=https://api.openai.com/v1

# The API key for authentication
AI_API_KEY=sk-your-api-key-here

# The model to use
# Examples: gpt-4o, gpt-4o-mini, claude-3-haiku-20240307 (if using Anthropic via proxy), etc.
AI_MODEL=gpt-4o-mini

# Optional: maximum number of tokens in the response (default: 1024)
AI_MAX_TOKENS=1024

# Optional: temperature (0.0 - 2.0). Higher = more creative, lower = more deterministic (default: 0.7)
AI_TEMPERATURE=0.7

# Optional: number of automatic retries per AI call if it fails (default: 0)
# AI_RETRY=1

# Idle deadline for a single model call, in milliseconds (default: 3600000 =
# 60 min; set to 0 to disable). All fetch timeouts are disabled (local
# servers can prefill for minutes), so this is the ONLY wall-clock bound on
# a call: it aborts a call that makes no progress (no streamed events) for
# this long — a dead container would otherwise hang an un-monitored run
# forever. It is an IDLE timeout (reset on every event), so a healthy long
# call is never aborted.
# AI_CALL_DEADLINE_MS=3600000

# "true" to enable the Qwen3 thinking phase for ALL calls (one-shot and agent).
# Leave unset: thinking is ON by default.
#
# AI_THINKING_LEVEL=xhigh
#
# Controls the reasoning_effort parameter when thinking is ON.
# Valid values: "low", "medium", "xhigh" (model-dependent).
# "xhigh" gives the strongest reasoning — highest quality but also
# highest token burn. Tune down to "medium" or "low" if the reasoning
# spend is excessive relative to content output.
# Set AI_THINKING=false to disable thinking entirely.
# AI_THINKING=true

# ── Series ───────────────────────────────────────────────────────────────────

# the folder the series is located in. This is the ONLY thing you must tell the
# pipeline: the intake agent (npx gulp discover, step 0 of the default run)
# explores this folder and works out the rest for itself.
SERIES_LOCATION=./your-series-location

# OPTIONAL override: the name of the series in its original language. Leave it
# unset and the intake agent decides the name from what the books themselves
# say (their own titles, the series marker stored inside each file). Set it and
# it wins — the agent is told to use it exactly.
# SERIES_NAME=your_series_name

# ── Series intake (the discover step) ────────────────────────────────────────
# The intake agent reads the series folder, decides which files are volumes and
# in what order, decides the series name and the source language, creates each
# volume folder and stages its book inside, and writes the plan of record
# (translation-target.json) plus a human-readable translation-plan.md.

# Set to false to keep the old strict behavior: SERIES_NAME must then be in .env
# and volume folders must already be laid out as "<Series Name>(NN)/<file>".
# SERIES_AUTO_DISCOVER=true

# How many characters of a book's text the agent may read per sample call
# (default: 1500, max 6000). Raise it for a series whose books look alike.
# DISCOVER_SAMPLE_CHARS=1500

# The lowest confidence the agent may report before the run refuses to start
# (default: 0.6; 0 disables the gate). A wrong reading order corrupts every
# cumulative artifact, so an unsure plan is worth stopping for.
# DISCOVER_MIN_CONFIDENCE=0.6

# DISCOVER_STRICT=true turns a disagreement with the existing folder layout into
# an error instead of a warning (default: warn and keep the committed name).
# DISCOVER_STRICT=false

# How many intake attempts before the step fails (fresh agent per attempt,
# 10s apart). Default: 2.
# DISCOVER_MAX_ATTEMPTS=2

# ── Translation ──────────────────────────────────────────────────────────────

# OPTIONAL override: the language of the source material (fills
# {{SOURCE_LANGUAGE}} in the user prompts). Leave it unset and the intake agent
# decides it from the writing it actually read. Set it and it wins, whatever the
# agent concluded.
# TRANSLATION_SOURCE_LANGUAGE=Japanese

# the language to translate into (fills {{TARGET_LANGUAGE}} in the user prompts).
# This one is always yours — the intake agent cannot know which language you
# want to read the books in. (default: English)
TRANSLATION_TARGET_LANGUAGE=English

# ── Translation stage (role endpoints: TRANSLATE_* / VERIFY_* / EDIT_* / AUDIT_*) ──
# Each stage runs against its own endpoint named for the JOB it does — none of
# these names is a model, and the stage logic is the same whatever answers.
# Every role falls back to the global AI_* settings (the lines above), so a
# single-model setup needs nothing here. On local multi-model setups the
# per-machine hooks (hooks/) start the model container for each role — the
# local containers share one port, so only one can serve at a time. The tasks
# only run a GET /v1/models sanity check; they never start or stop containers.

# # translate / retranslate (Hy-MT2 — official 30B-A3B recipe: temp 0.7,
# # top_p 1.0, top_k -1, repetition_penalty 1.0; fast "no_think" mode by
# # default — the mode the model's published numbers are for)
# TRANSLATE_BASE_URL=
# TRANSLATE_API_KEY=
# TRANSLATE_MODEL=
# TRANSLATE_TEMPERATURE=0.7
# # "no_think" (default), "low", or "high" (also accepts true/false)
# TRANSLATE_THINKING=no_think
# # Chapter part size (chars); longer parts are split and translated in
# # order, each continuing the previous (default: 24000)
# TRANSLATE_CHUNK_CHARS=24000
# # Chars of the previous chapter's ending fed to the next chapter as
# # continuity context (default: 400)
# TRANSLATE_CONTINUITY_CHARS=400

# # translate-qa (the batched QA loop that replaces the fixed
# # verify -> retranslate -> verify sequence): up to N rounds of
# # [verify batch (verify model) + retranslate batch (translate model)],
# # mirroring the pre-production "translate -> validate -> apply ->
# # re-validate ..." loop. Stops early when every chapter passes
# # verification, when a round retranslates nothing new (stalled), or at
# # the round limit. Batched because the local model containers share one
# # port: each round costs at most two container switches (batch
# # boundaries only), and round N+1 only re-checks the chapters round N
# # retranslated. (default: 3)
# TRANSLATE_QA_MAX_ROUNDS=3

# # retranslate retry budget (the "stalled" guard's escape hatch): how many
# # times a chapter may be retranslated against an IDENTICAL set of
# # verification findings before the QA loop declares it stalled. The default
# # (2) allows one EXTRA fresh stochastic shot beyond the single retranslate —
# # the translator runs at temp 0.7, so a repeat on the same findings can
# # succeed even though the first didn't. A DIFFERENT findings set resets the
# # budget. Set to 1 to restore the old retranslate-once-then-stall behavior;
# # raise for more retries (each extra shot costs a translator call).
# # (default: 2)
# TRANSLATE_QA_RETRY_BUDGET=2

# # verify-translate (VERIFY_* role — source-anchored verification; DEFAULT-ON.
# # Set VERIFY_TRANSLATE_ENABLED=false to skip it and the retranslate pass.)
# VERIFY_TRANSLATE_ENABLED=true
# # Score (0–100) at or above which a chapter passes (default: 70)
# VERIFY_PASSING_SCORE=70
# VERIFY_BASE_URL=
# VERIFY_API_KEY=
# VERIFY_MODEL=
# VERIFY_TEMPERATURE=0.2
# VERIFY_THINKING=true
# VERIFY_THINKING_LEVEL=medium

# # polish (EDIT_* role — final proofreading pass; thinking ON, it runs last)
# # The polisher sees NO source text — surface cleanup of already-verified
# # text only (no re-translation by a non-translation model).
# EDIT_BASE_URL=
# EDIT_API_KEY=
# EDIT_MODEL=
# EDIT_TEMPERATURE=0.6
# EDIT_THINKING=true
# EDIT_THINKING_LEVEL=medium

# # The polish drift inspector (source-aware QA of the polish pass; DEFAULT-ON
# # — it is the semantic backstop for the source-free polisher. Set
# # POLISH_VERIFY_ENABLED=false to gate on the deterministic regression guard
# # only.) A FAIL re-polishes with the findings injected as correction tasks,
# # up to POLISH_QA_MAX_ROUNDS attempts per chapter; on exhaustion the draft
# # is kept and the findings persist for the next run.
# POLISH_VERIFY_ENABLED=true
# # Score (0–100) at or above which a polished text passes the drift check
# # (default: 70)
# POLISH_VERIFY_PASSING_SCORE=70
# # Drift-inspector sampling temperature (a judgment call — low) (default: 0.2)
# POLISH_VERIFY_TEMPERATURE=0.2
# # Max [polish + drift check] attempts per chapter (default: 3)
# POLISH_QA_MAX_ROUNDS=3

# # Per-stage chapter concurrency: how many chapters of one volume are
# # processed in parallel (default: 1 = serial — the local hardware runs one
# # inference at a time; raise only when the endpoint serves parallel
# # requests). The translate task stays serial by design (each chapter's
# # prompt carries the previous chapter's ending as continuity context).
# VERIFY_CONCURRENCY=1
# RETRANSLATE_CONCURRENCY=1
# POLISH_CONCURRENCY=1

# ── Cross-check audits (AUDIT_*) ─────────────────────────────────────────────
# The two cross-checks (verify borderline tiebreak + polish final audit) run on
# a SECOND endpoint — deliberately a different model from the one that produced
# the text being graded, or the check is one model marking its own homework.
# On local setups the audit container shares the model port, so the per-machine
# hooks (hooks/pre-verify-audit.sh, hooks/pre-polish-audit.sh) switch it in
# before each audit batch. The AUDIT_* vars name the endpoint (they fall back to
# AI_*; the model alias is usually "local" — the hook, not the name, selects
# the model).
# AUDIT_BASE_URL=
# AUDIT_API_KEY=
# AUDIT_MODEL=
# AUDIT_TEMPERATURE=0.2
# AUDIT_THINKING=true
# AUDIT_THINKING_LEVEL=medium
# # Chapters per audit batch processed in parallel (default: 1; raise only when
# # the endpoint serves parallel requests).
# AUDIT_CONCURRENCY=1
#
# # verify-translate borderline tiebreak (DEFAULT-ON): a chapter whose verify
# # score lands within ±VERIFY_TIEBREAK_BAND of the passing score is re-scored
# # on the AUDIT_* endpoint and the two scores are AVERAGED (a batched pass —
# # one endpoint switch, then all borderline chapters). Set
# # VERIFY_TIEBREAK_ENABLED=false to always trust the verifier's single score.
# VERIFY_TIEBREAK_ENABLED=true
# VERIFY_TIEBREAK_BAND=5

# ── Agents ───────────────────────────────────────────────────────────────────

# context window (tokens) at which agent sessions auto-compact. Set it to
# your model server's context size so compaction engages before the server
# runs out of context. (default: 128000)
# AGENT_CONTEXT_WINDOW=128000

# step cap for tool-using agents (each tool read/write counts as a step;
# per-role caps in the workflows are higher where needed) (default: 20)
# AGENT_MAX_STEPS=20

# runaway-generation guard: abort an agent turn when it produces more than
# this many characters of text with fewer than 3 tool calls. Catches models
# that emit malformed tool-call text instead of using the tool-calling API.
# (default: 30000)
# AGENT_TEXT_GUARD_CHARS=30000

# enable/disable recovery turns: when the author agent replies in chat
# instead of using writeFile, a recovery turn asks it to write the file
# using the content it already generated (default: true).
# AGENT_RECOVERY_ENABLED=true

# ── QA (validation -> acceptance -> feedback loop) ──────────────────────────

# the maximum number of validation -> acceptance -> feedback iterations per
# volume before the output is left as-is (default: 10). Increased from the
# original default to accommodate the rolling-average acceptance criterion.
QA_MAX_ITERATIONS=10

# ── score-based acceptance ───────────────────────────────────────────────────
# The acceptance one-shot check scores the audited output 0–100
# (100 = perfect, 0 = atrocious). Scores are tracked in a rolling window;
# the volume is accepted when the window meets the criterion below.

# Rolling window size: number of recent acceptance checks to consider.
# 2 = accept once the two most recent checks meet the criterion (the writer
# rewrites the artifact every round, so older scores describe states that no
# longer exist — the window only smooths the grader's variance).
# (default: 2)
# ACCEPTANCE_WINDOW_SIZE=2

# Minimum samples before the criterion can trigger acceptance.
# (default: 2)
# ACCEPTANCE_MIN_SAMPLES=2

# Passing score (0–100). 70 is the boundary of the acceptance rubric's
# "Pass with minor edits" (70–84) / "Requires revision" (40–69) bands, so
# the default reproduces the legacy PASS/FAIL accept/reject set.
# (default: 70)
# ACCEPTANCE_PASSING_SCORE=70

# Acceptance strategy for the rolling window:
#   average — the mean of the recent scores must be >= ACCEPTANCE_PASSING_SCORE
#   best    — at least ACCEPTANCE_BEST_MIN_PASSES of the recent scores must be
#             >= ACCEPTANCE_PASSING_SCORE (best-X-out-of-Y)
# (default: average)
# ACCEPTANCE_STRATEGY=average

# For ACCEPTANCE_STRATEGY=best: minimum number of recent scores that must
# individually meet the passing score. (default: 3 = "best 3 of 5")
# ACCEPTANCE_BEST_MIN_PASSES=3

# ── Un-monitored run policies ────────────────────────────────────────────────
# The pipeline is built to run un-monitored overnight / for multiple days.
# These knobs front-load the decisions that would otherwise need a human at
# the keyboard, so a long run never halts waiting for one. Every default
# below is the safe "fail loudly" behavior; for an un-monitored run, set the
# "continue" values so skipped work is picked up cheaply on a re-run
# (idempotent skip-checks make re-runs cheap).

# What to do when a volume's processing fails:
#   abort — stop the task (default; safest for interactive runs)
#   skip  — log the error and continue with the next volume
# ON_VOLUME_ERROR=abort

# What to do when a cumulative task (glossary / character-voice / style-guide)
# finds the previous volume's artifact missing (e.g. that volume failed or was
# skipped above):
#   abort — fail loudly (default)
#   skip  — warn and skip the volume (later volumes cascade the same way)
# ON_MISSING_PREVIOUS=abort

# What to do when a volume hits the QA iteration limit without a passing grade:
#   accept — keep the output as-is and continue (default)
#   fail   — treat the volume as failed (then subject to ON_VOLUME_ERROR)
# ON_QA_LIMIT=accept

# What to do when a whole task (step) fails in the default all-ten run:
#   abort — stop at the first failing task (default)
#   continue — run the remaining tasks, then fail the run with a summary
# ON_TASK_ERROR=abort

# How many times to retry the discovery agent (translation-target.json) before
# failing the task. Each attempt is a fresh agent; per-attempt endpoint
# retries still apply via AI_RETRY. (default: 1)
# DISCOVERY_MAX_ATTEMPTS=1

# ── Output locations ─────────────────────────────────────────────────────────

# where to save the generated glossary (default: <SERIES_LOCATION>/glossary.md)
# GLOSSARY_OUTPUT_FILE=

# where to save the generated character voice reference
# (default: <SERIES_LOCATION>/character-voice.md)
# VOICE_OUTPUT_FILE=

# where to save the generated style guide
# (default: <SERIES_LOCATION>/style-guide.md)
# STYLE_OUTPUT_FILE=

# where to save the newest per-volume shared wiki (the series-level "living"
# wiki; copied after the jump-in-wiki task — default:
# <SERIES_LOCATION>/shared-wiki.md)
# SHARED_WIKI_OUTPUT_FILE=

# ── Research (glossary terms) ────────────────────────────────────────────────

# enable/disable client-side web research for glossary terms (default: true)
RESEARCH_ENABLED=true

# number of parallel research agents to run simultaneously (one per term).
# Default: 1 (sequential) — the local inference server serves one request at
# a time, and parallel agents would issue concurrent editFile calls on the
# shared research notes file (edits are non-atomic read-modify-write, so
# parallel agents could clobber each other's notes). Raise only when the
# endpoint genuinely serves parallel requests.
# RESEARCH_CONCURRENCY=1

# max search results to keep per language (default: 3)
RESEARCH_MAX_RESULTS=3

# max characters to keep from each Wikipedia extract (default: 800)
RESEARCH_EXTRACT_CHARS=800

# delay between research HTTP requests, in ms (default: 300)
RESEARCH_DELAY_MS=300

# per-request timeout for research HTTP requests, in ms (default: 30000)
RESEARCH_TIMEOUT_MS=30000

# Wikipedia languages to query, comma-separated (default: ja,en)
WIKI_LANGS=ja,en

# User-Agent sent to Wikipedia (it requires a descriptive one)
# WIKI_USER_AGENT=

# optional general web-search backend: brave, tavily, or serper (default: off)
# SEARCH_API=
# SEARCH_API_KEY=
