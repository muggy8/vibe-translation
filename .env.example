# OpenAI-compatible API configuration
# Copy this file to .env and fill in your values

# The base URL of your OpenAI-compatible endpoint
# Examples:
#   OpenAI:         https://api.openai.com/v1
#   Ollama (local): http://localhost:11434/v1
#   Azure:          https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
OPENAI_BASE_URL=https://api.openai.com/v1

# The API key for authentication
OPENAI_API_KEY=sk-your-api-key-here

# The model to use
# Examples: gpt-4o, gpt-4o-mini, claude-3-haiku-20240307 (if using Anthropic via proxy), etc.
OPENAI_MODEL=gpt-4o-mini

# Optional: maximum number of tokens in the response
MAX_TOKENS=1024

# Optional: temperature (0.0 - 2.0). Higher = more creative, lower = more deterministic
TEMPERATURE=0.7

# the name of the series in it's original language
SERIES_NAME_SOURCE=俺を好きなのはお前だけかよ