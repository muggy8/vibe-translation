# OpenAI-compatible AI client — environment configuration
# Copy this file to .env and fill in your values.
#
# One variable per decision. Where an older name is still accepted (so an
# existing .env keeps working), it is marked "legacy" below.

# ── AI provider (OpenAI-compatible endpoint) ────────────────────────────────

# The base URL of your OpenAI-compatible endpoint
# Examples:
#   OpenAI:         https://api.openai.com/v1
#   Ollama (local): http://localhost:11434/v1
#   Azure:          https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
AI_BASE_URL=https://api.openai.com/v1

# The API key for authentication
AI_API_KEY=sk-your-api-key-here

# The model to use
# Examples: gpt-4o, gpt-4o-mini, claude-3-haiku-20240307 (if using Anthropic via proxy), etc.
AI_MODEL=gpt-4o-mini

# Your model server's context window, in tokens. ONE number for one fact: it
# sizes agent auto-compaction AND the default output cap (a quarter of it), so
# the two can no longer contradict each other. Set it to what the server
# actually serves. (legacy name: AGENT_CONTEXT_WINDOW)
# (default: 128000)
# AI_CONTEXT_WINDOW=128000

# Optional: maximum OUTPUT tokens per call. Unset, it is derived as a quarter of
# AI_CONTEXT_WINDOW — a max_tokens equal to the context is rejected by several
# servers before the call even starts (the prompt gets nothing). Set this only
# to override the derived value.
# AI_MAX_TOKENS=

# Optional: temperature (0.0 - 2.0). Higher = more creative, lower = more
# deterministic. The house temperature — it also applies to the polish pass.
# (default: 0.7)
AI_TEMPERATURE=0.7

# Optional: number of automatic retries per AI call if it fails (default: 0)
# AI_RETRY=1

# Idle deadline for a single model call, in milliseconds (default: 3600000 =
# 60 min; set to 0 to disable). All fetch timeouts are disabled (local
# servers can prefill for minutes), so this is the ONLY wall-clock bound on
# a call: it aborts a call that makes no progress (no streamed events) for
# this long — a dead container would otherwise hang an un-monitored run
# forever. It is an IDLE timeout (reset on every event), so a healthy long
# call is never aborted.
# AI_CALL_DEADLINE_MS=3600000

# Thinking (the Qwen3-style reasoning phase) is ON by default for every call.
# AI_THINKING=false turns it off everywhere.
# AI_THINKING=true

# How hard the AUTHORING agents deliberate (the long artifact-writing turns):
# "low", "medium" or "xhigh" (model-dependent). "xhigh" is the strongest
# reasoning and the highest token burn — tune down if the reasoning spend is
# excessive relative to the text produced. The judging/proofreading stages use
# STAGE_THINKING_LEVEL below, deliberately one notch calmer.
# (default: xhigh)
# AI_THINKING_LEVEL=xhigh

# ── Series ───────────────────────────────────────────────────────────────────

# the folder the series is located in. This is the ONLY thing you must tell the
# pipeline: the intake agent (npx gulp discover, step 0 of the default run)
# explores this folder and works out the rest for itself.
SERIES_LOCATION=./your-series-location

# OPTIONAL override: the name of the series in its original language. Leave it
# unset and the intake agent decides the name from what the books themselves
# say (their own titles, the series marker stored inside each file). Set it and
# it wins — the agent is told to use it exactly.
# SERIES_NAME=your_series_name

# ── Series intake (the discover step) ────────────────────────────────────────
# The intake agent reads the series folder, decides which files are volumes and
# in what order, decides the series name and the source language, creates each
# volume folder and stages its book inside, and writes the plan of record
# (translation-target.json) plus a human-readable translation-plan.md.

# How many characters of a book's text the agent may read per sample call
# (default: 1500, max 6000). Raise it for a series whose books look alike.
# DISCOVER_SAMPLE_CHARS=1500

# The "is there a readable text at all" floor (default: 1000). NOT a
# story-length rule — "is this a real narrative?" is the agent's call (each
# volume carries an integrity block). This only catches the objective case: a
# file that yields essentially no text is binary junk, an empty archive, or a
# stub, whatever the agent believed. An art book is rejected separately by its
# image-dominated archive size, not by this number.
# DISCOVER_MIN_VOLUME_TEXT_CHARS=1000

# The lowest confidence the agent may report before the run refuses to start
# (default: 0.6; 0 disables the gate). A wrong reading order corrupts every
# cumulative artifact, so an unsure plan is worth stopping for.
# DISCOVER_MIN_CONFIDENCE=0.6

# DISCOVER_STRICT=true turns a disagreement with the existing folder layout into
# an error instead of a warning (default: warn and keep the committed name).
# DISCOVER_STRICT=false

# How many intake attempts before the step fails (fresh agent per attempt,
# 10s apart). (default: 2; legacy name: DISCOVERY_MAX_ATTEMPTS)
# DISCOVER_MAX_ATTEMPTS=2

# ── Translation ──────────────────────────────────────────────────────────────

# OPTIONAL override: the language of the source material (fills
# {{SOURCE_LANGUAGE}} in the user prompts). Leave it unset and the intake agent
# decides it from the writing it actually read. Set it and it wins, whatever the
# agent concluded.
# TRANSLATION_SOURCE_LANGUAGE=Japanese

# the language to translate into (fills {{TARGET_LANGUAGE}} in the user prompts).
# This one is always yours — the intake agent cannot know which language you
# want to read the books in. (default: English)
TRANSLATION_TARGET_LANGUAGE=English

# Per-series override for the deterministic QA length-ratio band (the band the
# chapter's draft length must fall inside to avoid a "may be truncated or
# padded" warning). Format "min-max" or "min-max-truncation". Leave unset and
# the per-pair default is used (JA→EN 0.6–2.5, ZH→EN 0.7–3.2, KO→EN 0.5–2.6 —
# Chinese compresses harder, so its English is longer). The source-script
# residue check is automatic per pair (JA→EN counts kana+Han, JA→ZH only kana,
# KO→EN Hangul, ZH→EN Han); no setting needed.
# TRANSLATION_LENGTH_RATIO=0.6-2.5

# ── The one passing threshold ────────────────────────────────────────────────
# Every scored gate in the pipeline uses the same 0–100 rubric and therefore
# one threshold: the acceptance check on the four volume artifacts, chapter
# verification, and the polish drift audit. 70 is the boundary of the rubric's
# "Pass with minor edits" (70–84) / "Requires revision" (40–69) bands.
# (legacy names, still honored: ACCEPTANCE_PASSING_SCORE, VERIFY_PASSING_SCORE,
#  POLISH_VERIFY_PASSING_SCORE)
# PASSING_SCORE=70

# ── Translation stage (role endpoints: TRANSLATE_* / VERIFY_* / EDIT_* / AUDIT_*) ──
# Each stage runs against its own endpoint named for the JOB it does — none of
# these names is a model, and the stage logic is the same whatever answers.
# Every role falls back to the global AI_* settings (the lines above), so a
# single-model setup needs nothing here. On local multi-model setups the
# per-machine hooks (hooks/) start the model container for each role — the
# local containers share one port, so only one can serve at a time. The tasks
# only run a GET /v1/models sanity check; they never start or stop containers.

# # translate / retranslate (Hy-MT2 — official 30B-A3B recipe: temp 0.7,
# # top_p 1.0, top_k -1, repetition_penalty 1.0; fast "no_think" mode by
# # default — the mode the model's published numbers are for). These stay
# # separate from AI_TEMPERATURE because they are the model's contract.
# TRANSLATE_BASE_URL=
# TRANSLATE_API_KEY=
# TRANSLATE_MODEL=
# TRANSLATE_TEMPERATURE=0.7
# # "no_think" (default), "low", or "high" (also accepts true/false)
# TRANSLATE_THINKING=no_think
# # Chapter part size (chars); longer parts are split and translated in
# # order, each continuing the previous (default: 24000)
# TRANSLATE_CHUNK_CHARS=24000
# # Chars of the previous chapter's ending fed to the next chapter as
# # continuity context (default: 400)
# TRANSLATE_CONTINUITY_CHARS=400

# # translate-qa (the batched QA loop): up to N rounds of
# # [verify batch (verify model) + retranslate batch (translate model)],
# # mirroring the pre-production "translate -> validate -> apply ->
# # re-validate ..." loop. Stops early when every chapter passes
# # verification, when a round retranslates nothing new (stalled), or at
# # the round limit. Batched because the local model containers share one
# # port: each round costs at most two container switches (batch
# # boundaries only), and round N+1 only re-checks the chapters round N
# # retranslated. (default: 3)
# TRANSLATE_QA_MAX_ROUNDS=3

# # retranslate retry budget (the "stalled" guard's escape hatch): how many
# # times a chapter may be retranslated against an IDENTICAL set of
# # verification findings before the QA loop declares it stalled. The default
# # (2) allows one EXTRA fresh stochastic shot beyond the single retranslate —
# # the translator runs at temp 0.7, so a repeat on the same findings can
# # succeed even though the first didn't. A DIFFERENT findings set resets the
# # budget. Set to 1 to restore retranslate-once-then-stall; raise for more
# # retries (each extra shot costs a translator call).
# # (default: 2)
# TRANSLATE_QA_RETRY_BUDGET=2

# # verify-translate (VERIFY_* role — source-anchored verification; DEFAULT-ON.
# # Set VERIFY_TRANSLATE_ENABLED=false to skip it and the retranslate pass.)
# VERIFY_TRANSLATE_ENABLED=true
# VERIFY_BASE_URL=
# VERIFY_API_KEY=
# VERIFY_MODEL=

# # polish (EDIT_* role — final proofreading pass). The polisher sees NO source
# # text — surface cleanup of already-verified text only (no re-translation by a
# # non-translation model). Its temperature is AI_TEMPERATURE and its thinking
# # follows AI_THINKING + STAGE_THINKING_LEVEL.
# EDIT_BASE_URL=
# EDIT_API_KEY=
# EDIT_MODEL=

# # The polish drift inspector (source-aware QA of the polish pass; DEFAULT-ON
# # — it is the semantic backstop for the source-free polisher. Set
# # POLISH_VERIFY_ENABLED=false to gate on the deterministic regression guard
# # only.) A FAIL re-polishes with the findings injected as correction tasks,
# # up to POLISH_QA_MAX_ROUNDS attempts per chapter; on exhaustion the draft
# # is kept and the findings persist for the next run.
# POLISH_VERIFY_ENABLED=true
# POLISH_QA_MAX_ROUNDS=3

# ── Cross-check audits (AUDIT_*) ─────────────────────────────────────────────
# The two cross-checks (verify borderline tiebreak + polish final audit) run on
# a SECOND endpoint — deliberately a different model from the one that produced
# the text being graded, or the check is one model marking its own homework.
# On local setups the audit container shares the model port, so the per-machine
# hooks (hooks/pre-verify-audit.sh, hooks/pre-polish-audit.sh) switch it in
# before each audit batch. The AUDIT_* vars name the endpoint (they fall back to
# AI_*; the model alias is usually "local" — the hook, not the name, selects
# the model).
# AUDIT_BASE_URL=
# AUDIT_API_KEY=
# AUDIT_MODEL=
#
# # verify-translate borderline tiebreak (DEFAULT-ON): a chapter whose verify
# # score lands within ±VERIFY_TIEBREAK_BAND of the passing score is re-scored
# # on the AUDIT_* endpoint and the two scores are AVERAGED (a batched pass —
# # one endpoint switch, then all borderline chapters). Set
# # VERIFY_TIEBREAK_ENABLED=false to always trust the verifier's single score.
# VERIFY_TIEBREAK_ENABLED=true
# VERIFY_TIEBREAK_BAND=5
# # An average may not manufacture a pass that NEITHER grader gave: when both
# # scores sit below the passing line the chapter stays a FAIL whatever the
# # average says. A FAIL->PASS flip is allowed (that is what a second opinion
# # is for) and is recorded as a tiebreak rescue.
#
# # Repeat sampling (DEFAULT-ON): a chapter whose score lands within
# # ±VERIFY_SAMPLE_BAND of the passing line is graded VERIFY_SAMPLES times and
# # the MEDIAN is used — one grader's bad hour is not a FAIL. Chapters far from
# # the line are graded once: the repeat exists to protect a coin-flip decision,
# # not to double the bill. VERIFY_SAMPLES maxes out at 5.
# VERIFY_SAMPLES=2
# VERIFY_SAMPLE_BAND=8
#
# # Retranslation value filter: a chapter that missed the passing score by less
# # than this much on MEDIUM/LOW findings only is a copy-edit, not a
# # re-translation — a fresh pass can introduce new errors while fixing a nit,
# # and it costs a whole chapter of generation. A HIGH finding, a
# # deterministic-QA failure, or an unparseable score is always worth it;
# # chapters skipped by this filter are counted and reported, never silently
# # dropped. Set 0 to retranslate every FAIL.
# TRANSLATE_RETRANSLATE_VALUE_MARGIN=5
#
# # Below this many characters of source, translate skips the chapter WITHOUT a
# # model call and records it as "empty in source" (a blank page, an image-only
# # page). Deliberately far below SOURCE_EMPTY_SEGMENT_CHARS so a genuinely
# # short interlude is still translated.
# TRANSLATION_EMPTY_SOURCE_CHARS=40
#
# # Targeted correction (default ON). When the verification findings quote spans
# # that can be located in the source, only those passages are re-translated and
# # stitched back into the draft — one bad sentence no longer costs a whole
# # chapter of fresh generation (and a fresh chance to break what was already
# # right). Every case where the source↔draft mapping cannot be trusted falls
# # back to the whole-chapter pass automatically, so setting this to false only
# # turns the shortcut off. (default: true)
# TRANSLATE_TARGETED_FIX=true
#
# # The cross-chapter audit (default ON): the only pass that reads a volume's
# # published chapters TOGETHER, for the drift a per-chapter check structurally
# # cannot see (a name rendered two ways, a fact chapter 3 states and chapter 9
# # denies). It rides in the existing AUDIT_* batch, so it costs no extra model
# # switch. The deterministic rendering-variant scan runs either way.
# # (default: true)
# VOLUME_CONSISTENCY_ENABLED=true
#
# # Per-role request size: the four roles are not one model, so each may get its
# # own context window and output cap (set these where you set the hook mapping —
# # they describe the container the hook starts). Unset, the role uses the global
# # AI_CONTEXT_WINDOW / AI_MAX_TOKENS.
# TRANSLATE_CONTEXT_WINDOW=
# TRANSLATE_MAX_TOKENS=
# VERIFY_CONTEXT_WINDOW=
# VERIFY_MAX_TOKENS=
# EDIT_CONTEXT_WINDOW=
# EDIT_MAX_TOKENS=
# AUDIT_CONTEXT_WINDOW=
# AUDIT_MAX_TOKENS=

# ── Judging and stage deliberation ───────────────────────────────────────────
# One pair of knobs for every call that GRADES text (chapter verification, the
# verify tiebreak, the polish drift audit) instead of six.

# Sampling temperature for grading — a judgment call wants a stable one.
# (legacy names, still honored: VERIFY_TEMPERATURE, AUDIT_TEMPERATURE)
# (default: 0.2)
# JUDGE_TEMPERATURE=0.2

# How hard the stage calls deliberate (verify / audit / polish). Lower than the
# authoring agents' AI_THINKING_LEVEL: these judge or proofread one chapter,
# they do not write a long artifact. AI_THINKING=false turns thinking off for
# them too. (legacy names: VERIFY_THINKING[_LEVEL], EDIT_THINKING[_LEVEL],
# AUDIT_THINKING[_LEVEL])
# (default: medium)
# STAGE_THINKING_LEVEL=medium

# ── Concurrency ──────────────────────────────────────────────────────────────
# How many independent units a stage runs at once: chapters per verify /
# retranslate / polish pass, chapters per audit batch, research agents per
# glossary term. 1 = serial, which is what a single local inference server can
# serve. Raise only when the endpoint genuinely handles parallel requests.
# The translate task stays serial by design (each chapter's prompt carries the
# previous chapter's ending as continuity context).
# (legacy per-stage names, still honored as overrides: RESEARCH_CONCURRENCY,
#  VERIFY_CONCURRENCY, RETRANSLATE_CONCURRENCY, POLISH_CONCURRENCY,
#  AUDIT_CONCURRENCY)
# (default: 1)
# STAGE_CONCURRENCY=1

# ── Agents ───────────────────────────────────────────────────────────────────

# step cap for tool-using agents (each tool read/write counts as a step;
# per-role caps in the workflows are higher where needed) (default: 20)
# AGENT_MAX_STEPS=20

# runaway-generation guard: abort an agent turn when it produces more than
# this many characters of text with fewer than 3 tool calls. Catches models
# that emit malformed tool-call text instead of using the tool-calling API.
# (default: 30000)
# AGENT_TEXT_GUARD_CHARS=30000

# enable/disable recovery turns: when the author agent replies in chat
# instead of using writeFile, a recovery turn asks it to write the file
# using the content it already generated (default: true).
# AGENT_RECOVERY_ENABLED=true

# ── Hooks ────────────────────────────────────────────────────────────────────

# How long a per-machine hook (hooks/pre-*, hooks/post-*) may run before it is
# killed. A hung hook (a stuck model-switch poll, a wedged git push) would
# otherwise block an un-monitored run forever, so there is a wall-clock bound
# by default. Raise it for a hook that legitimately runs long; set 0 to disable
# the bound. (default: 1800000 = 30 minutes)
# AI_CLIENT_HOOK_TIMEOUT_MS=1800000

# ── QA (validation -> acceptance -> feedback loop) ──────────────────────────

# the maximum number of validation -> acceptance -> feedback iterations per
# volume before the output is left as-is (default: 10)
QA_MAX_ITERATIONS=10

# ── Source bundle ────────────────────────────────────────────────────────────
# How a volume's text is read. An epub is extracted once (cached); a whole
# installment under the threshold is processed as one document, otherwise the
# chapter-by-chapter fallback kicks in (--chunked forces it).

# Whole-installment char count above which the chapter-by-chapter fallback
# activates automatically. (default: 120000)
# SOURCE_CHUNK_THRESHOLD_CHARS=120000

# The extraction's "this section converted to nothing" floor: a spine item whose
# extracted text is shorter is flagged empty and reported at extraction (a blank
# page, an image-only page, text in a structure the converter does not map).
# Distinct from TRANSLATION_EMPTY_SOURCE_CHARS (above), which is the translation
# stage's "do not spend a model call on this" floor. (default: 200)
# SOURCE_EMPTY_SEGMENT_CHARS=200

# ── score-based acceptance ───────────────────────────────────────────────────
# The acceptance one-shot check scores the audited output 0–100 (100 = perfect,
# 0 = atrocious). Scores are tracked in a rolling window; the volume is accepted
# when the window meets the criterion. The threshold is PASSING_SCORE (above).

# Rolling window size: number of recent acceptance checks to consider.
# 2 = accept once the two most recent checks meet the criterion (the writer
# rewrites the artifact every round, so older scores describe states that no
# longer exist — the window only smooths the grader's variance). How many
# checks the window needs before it can fire is derived from it, not a separate
# knob. (default: 2)
# ACCEPTANCE_WINDOW_SIZE=2

# The lowest a SINGLE score in that window may be. Without a floor an average
# launders a rejection: with a window of 2 and a passing score of 69, scores of
# [100, 38] accepted an artifact one grader had called atrocious because the
# other one loved it. Default: PASSING_SCORE - 15. Set 0 to restore pure
# averaging.
# ACCEPTANCE_SAMPLE_FLOOR=

# ── exceptional scores: is a great grade real, or a fluke? ──────────────────
# A first acceptance grade in the rubric's top band is re-graded a few more
# times on the SAME artifact before the volume is accepted. If the grades agree,
# the volume is accepted on the spot — no feedback pass, no second full
# validator turn (the expensive part of a loop iteration). If they collapse, the
# scores stand and the normal loop continues.
#
# ACCEPTANCE_EXCEPTIONAL_SCORE=85   # the exceptional floor (default: 85, the
#                                   # rubric's "Pass" band starts here)
# ACCEPTANCE_SCORE_TOLERANCE=3      # how far a confirmation grade may fall
#                                   # before the great grade is called a fluke
#                                   # (default: 3)
# ACCEPTANCE_CONFIRMATION_CHECKS=2  # extra grades to run; the FIRST is always
#                                   # at temperature 0 — the deterministic
#                                   # anchor, and it must itself be exceptional
#                                   # for the fast accept to fire (default: 2)
#
# (The old ACCEPTANCE_STRATEGY / ACCEPTANCE_BEST_MIN_PASSES knobs are gone. The
# "best" strategy asked for more passing scores than the window could ever hold,
# so it could never accept anything; setting those names now does nothing.)

# ── Un-monitored run policies ────────────────────────────────────────────────
# The pipeline is built to run un-monitored overnight / for multiple days.
# These knobs front-load the decisions that would otherwise need a human at
# the keyboard, so a long run never halts waiting for one. Every default
# below is the safe "fail loudly" behavior; for an un-monitored run, set the
# "continue" values so skipped work is picked up cheaply on a re-run
# (idempotent skip-checks make re-runs cheap).

# What to do when a volume's processing fails:
#   abort — stop the task (default; safest for interactive runs)
#   skip  — log the error and continue with the next volume
# ON_VOLUME_ERROR=abort

# What to do when a cumulative task (glossary / character-voice / style-guide)
# finds the previous volume's artifact missing (e.g. that volume failed or was
# skipped above):
#   abort — fail loudly (default)
#   skip  — warn and skip the volume (later volumes cascade the same way)
# ON_MISSING_PREVIOUS=abort

# What to do when a volume hits the QA iteration limit without a passing grade:
#   accept — keep the output as-is and continue (default)
#   fail   — treat the volume as failed (then subject to ON_VOLUME_ERROR)
# ON_QA_LIMIT=accept

# What to do when a whole task (step) fails in the default all-ten run:
#   abort — stop at the first failing task (default)
#   continue — run the remaining tasks, then fail the run with a summary
# ON_TASK_ERROR=abort

# ── Output locations ─────────────────────────────────────────────────────────

# Where the four series-level copies (glossary.md, character-voice.md,
# style-guide.md, shared-wiki.md) are published. Default: the series root.
# (legacy per-file names, still honored as overrides: GLOSSARY_OUTPUT_FILE,
#  VOICE_OUTPUT_FILE, STYLE_OUTPUT_FILE, SHARED_WIKI_OUTPUT_FILE)
# SERIES_ARTIFACTS_DIR=

# ── Research (glossary terms) ────────────────────────────────────────────────

# enable/disable client-side web research for glossary terms (default: true)
RESEARCH_ENABLED=true

# max search results to keep per language (default: 3)
RESEARCH_MAX_RESULTS=3

# max characters to keep from each Wikipedia extract (default: 800)
RESEARCH_EXTRACT_CHARS=800

# delay between research HTTP requests, in ms (default: 300)
RESEARCH_DELAY_MS=300

# per-request timeout for research HTTP requests, in ms (default: 30000)
RESEARCH_TIMEOUT_MS=30000

# Wikipedia languages to query, comma-separated (default: ja,en)
WIKI_LANGS=ja,en

# User-Agent sent to Wikipedia (it requires a descriptive one)
# WIKI_USER_AGENT=

# optional general web-search backend: brave, tavily, or serper (default: off)
# SEARCH_API=
# SEARCH_API_KEY=
