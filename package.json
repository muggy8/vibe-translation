{
  "name": "ai-client",
  "version": "2.0.0",
  "description": "Agentic AI client (OpenHarness) that works a light-novel series volume by volume: the pre-production references (glossary, character voice, style guide, wiki, consistency audit), the translation chain (translate → verify → retranslate → polish), and the delivery layer that assesses each step and repairs what it finds",
  "main": "index.js",
  "scripts": {
    "start": "node autopilot.js --mode=act",
    "pipeline": "node index.js",
    "delivery": "node delivery.js",
    "diagnose": "node diagnose.js",
    "fix": "node fix.js",
    "autopilot": "node autopilot.js",
    "rebuild-voice": "node rebuild-voice.js",
    "re-render-glossary": "node re-render-glossary.js",
    "extract-voice": "node extract-voice.js",
    "reopen": "node reopen-volume.js",
    "attribute-voice": "node attribute-voice.js",
    "release-translation": "node release-translation.js",
    "test": "node test/runner.js",
    "pipeline-loop": "node test/test-pipeline-loop.js",
    "pipeline-loop-chunked-glossary": "node test/test-pipeline-loop.js --stages=discover,extract,glossary,character-voice --chunked=glossary --dir=/tmp/opencode/pipeline-loop-chunked-glossary",
    "smoke": "node test/harness-smoke.js",
    "calibrate": "node test/calibrate.js",
    "docker:build": "docker compose build",
    "docker:run": "docker compose up --build",
    "docker:shell": "docker compose run --rm --entrypoint bash pipeline"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "ai",
    "glossary",
    "wiki",
    "translation",
    "openai",
    "openharness",
    "light-novel"
  ],
  "author": "ai-client contributors",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.104",
    "@openharness/core": "^0.7.0",
    "ai": "^6.0.270",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "file-type": "^22.0.1",
    "jszip": "^3.10.2",
    "natural-orderby": "^5.0.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "gulp": "^5.0.1"
  }
}
